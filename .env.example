# ============================================================
#  Environment variables — optional
# ============================================================
#  هذا المشروع ثابت (Static) ولا يحتاج أي متغيرات بيئة ليعمل.
#  هذا الملف توثيق فقط، ولا يُحمَّل تلقائيًا.
#
#  لتحديد رابط صوت سورة يس دون تعديل أي كود:
#  1) انسخ هذا الملف باسم assets/js/env.local.js
#     cp assets/js/env.local.example.js assets/js/env.local.js
#  2) عدّل القيمة أدناه
#  3) الملف مُدرج في .gitignore فلن يُرفع إلى GitHub
#
# ------------------------------------------------------------

# رابط مباشر لملف MP3 لسورة يس (يجب أن يبدأ بـ https)
# مثال: https://cdn.example.com/yaseen.mp3
SURAH_YASEEN_AUDIO_URL=

# ------------------------------------------------------------
#  ⚠️ لا تضع هنا أي مفتاح سري (API Token / Secret Key).
#  كل شيء في هذا المشروع يعمل في المتصفح مباشرة،
#  وأي قيمة تُكتب هنا تكون مرئية لكل من يفتح الموقع.
# ------------------------------------------------------------